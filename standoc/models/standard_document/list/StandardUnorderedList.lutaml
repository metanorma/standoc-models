class StandardUnorderedList {
  definition {
    Unordered list for standards documents.
  }
  +listitem: UnorderedCheckableListItem[0..*] {
    definition {
      Unordered list item for standards documents.
    }
  }
  +name: String[0..1] {
    definition {
      Caption of the list.
    }
  }
  +display: DisplayDirective[0..1] {
    definition {
      Directives on how to render this block.
    }
  }
}
