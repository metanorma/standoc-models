diagram StandardDoc_StandardDocument {
  title 'StandardDocument relationships'
  caption 'Elements of the StandardDocument model'

  include basic_document/BasicDocument.lml

  include basic_document/refs/ReferenceElement.lml
  include basic_document/refs/ReferenceToCitationElement.lml
  include basic_document/refs/ReferenceToIdElement.lml

  include standard_document/refs/ReferenceToTermbase.lml
  include standard_document/refs/ReferenceToTerm.lml

  include basic_document/elements/PageBreakElement.lml
  include standard_document/elements/StandardPageBreakElement.lml
  include standard_document/elements/OrientationType.lml

  include standard_document/StandardDocument.lml
  include standard_document/StandardDocumentType.lml

  include standard_document/sections/MiscContainer.lml
  include standard_document/sections/BoilerplateType.lml

  association {
    owner BasicDocument
    member StandardDocument
    owner_type inheritance
  }
  association {
    owner StandardDocument
    member StandardDocumentType
    owner_type direct
  }
  association {
    owner StandardDocument
    member BoilerplateType
    owner_type direct
  }
  association {
    owner StandardDocument
    member MiscContainer
    owner_type direct
  }
  association {
    owner BasicDocument
    member ReferenceElement
    owner_type direct
  }
  association {
    owner BasicDocument
    member PageBreakElement
    owner_type direct
  }
  association {
    owner PageBreakElement
    member StandardPageBreakElement
    owner_type inheritance
  }
  association {
    owner ReferenceElement
    member ReferenceToTerm
    owner_type inheritance
  }
  association {
    owner ReferenceElement
    member ReferenceToTermbase
    owner_type inheritance
  }
  association {
    owner ReferenceToTerm
    member ReferenceToTermSource
    owner_type direct
  }
  association {
    owner ReferenceToTermSource
    member ReferenceToCitationElement
    owner_type inheritance
  }
  association {
    owner ReferenceToTermSource
    member ReferenceToIdElement
    owner_type inheritance
  }
  association {
    owner ReferenceToTermSource
    member ReferenceToTermbase
    owner_type inheritance
  }
  association {
    owner StandardPageBreakElement
    member OrientationType
    owner_type direct
  }

}
