diagram StandardDoc_Blocks {
  title 'StandardDocument Blocks'
  caption 'Block elements of StandardDocument adapted from BasicDocument'

  include basic_document/BasicDocument.lml
  include basic_document/block/BasicBlockNoNotes.lml

  include basic_document/block/NoteBlock.lml
  include basic_document/block/FigureBlock.lml
  include basic_document/block/SourcecodeBlock.lml
  include basic_document/block/FormulaBlock.lml
  include basic_document/block/ExampleBlock.lml
  include basic_document/block/ParagraphBlock.lml
  include basic_document/block/QuoteBlock.lml
  include basic_document/block/AdmonitionBlock.lml
  include basic_document/block/TableBlock.lml
  include basic_document/block/AdmonitionType.lml
  include basic_document/block/AmendBlock.lml

  include standard_document/terms/TermSourceStatus.lml
  include standard_document/refs/StandocReferenceToCitationElement.lml
  include standard_document/refs/StandocReferenceToIdElement.lml

  include standard_document/block/StandardAmendBlock.lml
  include standard_document/block/StandardBlock.lml
  include standard_document/block/StandardBlockNoNotes.lml
  include standard_document/block/MultilingualRenderingType.lml
  include standard_document/block/StandardNoteBlock.lml
  include standard_document/block/StandardTableBlock.lml
  include standard_document/block/TableCol.lml
  include standard_document/block/StandardFigureBlock.lml
  include standard_document/block/StandardSourcecodeBlock.lml
  include standard_document/block/StandardFormulaBlock.lml
  include standard_document/block/StandardExampleBlock.lml
  include standard_document/block/StandardParagraphBlock.lml
  include standard_document/block/StandardQuoteBlock.lml
  include standard_document/block/StandardAdmonitionBlock.lml
  include standard_document/block/StandardAdmonitionType.lml
  include standard_document/block/BlockSource.lml
  include standard_document/block/AutoNumber.lml
  include standard_document/block/Key.lml

  association {
    owner BasicDocument
    member BasicBlockNoNotes
    owner_type direct
  }
  association {
    owner BasicBlockNoNotes
    member StandardBlockNoNotes
    owner_type inheritance
  }
  association {
    owner StandardBlockNoNotes
    member StandardBlock
    owner_type inheritance
  }
  association {
    owner StandardBlockNoNotes
    member MultilingualRenderingType
    owner_type direct
  }
  association {
    owner BasicBlockNoNotes
    member NoteBlock
    owner_type inheritance
  }
  association {
    owner BasicBlockNoNotes
    member TableBlock
    owner_type inheritance
  }
  association {
    owner StandardNoteBlock
    member NoteBlock
    member_type inheritance
  }
  association {
    owner TableBlock
    member StandardTableBlock
    owner_type inheritance
  }
  association {
    owner StandardTableBlock
    member BlockSource
    owner_type direct
  }
  association {
    owner StandardFigureBlock
    member BlockSource
    owner_type direct
  }
  association {
    owner StandardFigureBlock
    member Key
    owner_type direct
  }
  association {
    owner StandardFormulalock
    member Key
    owner_type direct
  }
  association {
    owner StandardTableBlock
    member Key
    owner_type direct
  }
  association {
    owner StandardTableBlock
    member TableCol
    owner_type direct
  }
  association {
    owner BlockSource
    member TermSourceStatus
    owner_type direct
  }
  association {
    owner BlockSource
    member ParagraphBlock
    owner_type direct
  }
  association {
    owner BasicBlockNoNotes
    member FigureBlock
    owner_type inheritance
  }
  association {
    owner FigureBlock
    member StandardFigureBlock
    owner_type inheritance
  }
  association {
    owner BasicBlockNoNotes
    member SourcecodeBlock
    owner_type inheritance
  }
  association {
    owner SourcecodeBlock
    member StandardSourcecodeBlock
    owner_type inheritance
  }
  association {
    owner BasicBlockNoNotes
    member AmendBlock
    owner_type inheritance
  }
  association {
    owner AmendBlock
    member StandardAmendBlock
    owner_type inheritance
  }
  association {
    owner StandardAmendBlock
    member AutoNumber
    owner_type direct
  }
  association {
    owner SourcecodeBlock
    member StandocReferenceToCitationElement
    owner_type direct
  }
  association {
    owner SourcecodeBlock
    member StandocReferenceToIdElement
    owner_type direct
  }
  association {
    owner BasicBlockNoNotes
    member FormulaBlock
    owner_type inheritance
  }
  association {
    owner FormulaBlock
    member StandardFormulaBlock
    owner_type inheritance
  }
  association {
    owner BasicBlockNoNotes
    member ExampleBlock
    owner_type inheritance
  }
  association {
    owner ExampleBlock
    member StandardExampleBlock
    owner_type inheritance
  }
  association {
    owner BasicBlockNoNotes
    member ParagraphBlock
    owner_type inheritance
  }
  association {
    owner ParagraphBlock
    member StandardParagraphBlock
    owner_type inheritance
  }
  association {
    owner BasicBlockNoNotes
    member QuoteBlock
    owner_type inheritance
  }
  association {
    owner QuoteBlock
    member StandardQuoteBlock
    owner_type inheritance
  }
  association {
    owner BasicBlockNoNotes
    member AdmonitionBlock
    owner_type inheritance
  }
  association {
    owner AdmonitionBlock
    member StandardAdmonitionBlock
    owner_type inheritance
  }
  association {
    owner AdmonitionType
    member StandardAdmonitionType
    owner_type inheritance
  }
  association {
    owner StandardBlockNoNotes
    member StandardNoteBlock
    owner_type inheritance
  }
  association {   
    owner StandardBlock
    member StandardFigureBlock
    owner_type inheritance
  }
  association {
    owner StandardBlock
    member StandardSourcecodeBlock
    owner_type inheritance
  }
  association {
    owner StandardBlock
    member StandardFormulaBlock
    owner_type inheritance
  }
  association {
    owner StandardBlock
    member StandardExampleBlock
    owner_type inheritance
  }
  association {
    owner StandardBlock
    member StandardParagraphBlock
    owner_type inheritance
  }
  association {
    owner StandardBlock
    member StandardQuoteBlock
    owner_type inheritance
  }
  association {
    owner StandardBlock
    member StandardAdmonitionBlock
    owner_type inheritance
  }
  association {
    owner StandardBlock
    member StandardTableBlock
    owner_type inheritance
  }

}
