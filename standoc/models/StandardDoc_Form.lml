diagram StandardDoc_Form {
  title 'StandardDocument Inline'
  caption 'Form elements of StandardDocument'

  include standard_document/block/Form.lml
  include standard_document/elements/FormInput.lml
  include standard_document/elements/Input.lml
  include standard_document/elements/InputType.lml
  include standard_document/elements/Label.lml
  include standard_document/elements/Select.lml
  include standard_document/elements/Option.lml
  include standard_document/elements/Textarea.lml

  association {
    owner Form
    member FormInput
    owner_type direct
  }
  association {
    owner Form
    member Label
    owner_type direct
  }
  association {
    owner FormInput
    member Input
    owner_type inheritance
  }
  association {
    owner FormInput
    member Select
    owner_type inheritance
  }
  association {
    owner FormInput
    member Textarea
    owner_type inheritance
  }
  association {
    owner Input
    member InputType
    owner_type direct
  }
  association {
    owner ReferenceToIdElement
    member Label
    owner_type inheritance
  }
  association {
    owner Select
    member Option
    owner_type direct
  }
}
