diagram StandardDoc_StandardDocument {
  title 'StandardDocument relationships'
  caption 'Elements of the StandardDocument model'

  include ../models/basic_document/BasicDocument.lml

  include ../models/standard_document/StandardDocument.lml
  include ../models/standard_document/StandardDocumentType.lml

  include ../models/standard_document/sections/MiscContainer.lml
  include ../models/standard_document/sections/BoilerplateType.lml

  association {
    owner BasicDocument
    member StandardDocument
    owner_type inheritance
  }
  association {
    owner StandardDocument
    member StandardDocumentType
    owner_type direct
  }
  association {
    owner StandardDocument
    member BoilerplateType
    owner_type direct
  }
  association {
    owner StandardDocument
    member MiscContainer
    owner_type direct
  }
}
