diagram GbDocument {

  include gb_document/GbStandardDocument.lml
  include gb_document/metadata/GbBibliographicItem.lml
  include gb_document/metadata/Ccs.lml
  include gb_document/metadata/GbTechnicalCommittee.lml
  include gb_document/metadata/GbStandardType.lml
  include gb_document/metadata/GbStandardPrefix.lml
  include gb_document/metadata/GbTechnicalCommitteeType.lml
  include gb_document/metadata/GbStandardScope.lml
  include gb_document/metadata/GbStandardMandate.lml
  include gb_document/metadata/GbStandardTopic.lml
  include gb_document/metadata/GbDocumentType.lml

  association {
    owner IsoStandardDocument
    member GbStandardDocument
    owner_type inheritance
  }

  association {
    owner IsoBibliographicItem
    member GbBibliographicItem
    owner_type inheritance
  }
  association {
    owner GbStandardDocument
    member GbBibliographicItem
    owner_type direct
  }

  association {
    owner GbBibliographicItem
    member Ccs
    owner_type direct
  }
  association {
    owner GbBibliographicItem
    member GbTechnicalCommittee
    owner_type direct
  }
  association {
    owner GbBibliographicItem
    member GbStandardType
    owner_type direct
  }
  association {
    owner GbBibliographicItem
    member GbStandardTopic
    owner_type direct
  }
  association {
    owner GbBibliographicItem
    member GbDocumentType
    owner_type direct
  }

  association {
    owner GbTechnicalCommittee
    member GbTechnicalCommitteeType
    owner_type direct
  }

  association {
    owner GbStandardType
    member GbStandardScope
    owner_type direct
  }
  association {
    owner GbStandardType
    member GbStandardMandate
    owner_type direct
  }
  association {
    owner GbStandardType
    member GbStandardPrefix
    owner_type direct
  }

}
