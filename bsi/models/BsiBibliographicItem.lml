diagram IsoDoc_IsoBibliographicItem {
  include bsi_document/metadata/BsiBibliographicItem.lml
  include bsi_document/metadata/BsiDocumentType.lml
  include bsi_document/metadata/BsiDocumentSubtype.lml
  include bsi_document/metadata/BsiBibDataExtensionType.lml

  association {
    owner BsiBibliographicItem
    member BsiDocumentType
    owner_type direct
  }
  association {
    owner BsiBibliographicItem
    member BsiBibDataExtensionType
    owner_type direct
  }
  association {
    owner BsiBibDataExtensionType
    member BsiDocumentSubtype
    owner_type direct
  }
  association {
    owner BsiBibDataExtensionType
    member IcsType
    owner_type direct
  }
  association {
    owner BsiBibDataExtensionType
    member StructuredIdentifierType
    owner_type direct
  }
  association {
    owner BsiBibDataExtensionType
    member Image
    owner_type direct
  }
}
