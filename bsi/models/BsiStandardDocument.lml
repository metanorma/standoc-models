diagram Bsi_BsiStandardDocument {
  include bsi_document/BsiStandardDocument.lml
  include bsi_document/blocks/BsiAdmonitionBlock.lml
  include bsi_document/blocks/BsiAdmonitionType.lml
  include bsi_document/blocks/BsiFigureBlock.lml
  include bsi_document/blocks/BsiFigureWidthType.lml
  include bsi_document/blocks/BsiTableBlock.lml

  association {
    owner IsoStandardDocument
    member BsiStandardDocument
    owner_type inheritance
  }
  association {
    owner BsiStandardDocument
    member BsiAdmonitionBlock
    owner_type direct
  }
  association {
    owner IsoAdmonitionBlock
    member BsiAdmonitionBlock
    owner_type inheritance
  }
  association {
    owner IsoAdmonitionType
    member BsiAdmonitionType
    owner_type inheritance
  }
  association {
    owner BsiAdmonitionBlock
    member IdElement
    owner_type direct
  }
  association {
    owner BsiAdmonitionBlock
    member BsiAdmonitionType
    owner_type direct
  }
  association {
    owner FigureBlock
    member BsiFigureBlock
    owner_type inheritance
  }
  association {
    owner BsiFigureBlock
    member BsiFigureWidthType
    owner_type direct
  }
  association {
    owner TableBlock
    member BsiTableBlock
    owner_type inheritance
  }
}
