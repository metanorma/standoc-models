diagram IsoDoc_IsoBlocks {
  title 'ISO Blocks'
  caption 'Block elements of ISO Standard Model'


  include basic_document/multiparagraphs/AdmonitionBlock.lml
  include iso_document/blocks/IsoAdmonitionBlock.lml
  include iso_document/blocks/IsoAdmonitionType.lml

  include standard_document/terms/TermCollection.lml
  include standard_document/terms/Term.lml
  include iso_document/terms/IsoTermCollection.lml
  include iso_document/terms/IsoTerm.lml

  association {
    owner TermCollection
    member IsoTermCollection
    owner_type inheritance
  }
  association {
    owner Term
    member IsoTerm
    owner_type inheritance
  }
  association {
    owner AdmonitionBlock
    member IsoAdmonitionBlock
    owner_type inheritance
  }
  association {
    owner IsoAdmonitionBlock
    member IsoAdmonitionType
    owner_type direct
  }

}
