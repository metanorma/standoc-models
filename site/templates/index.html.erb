<section class="hero wrap">
  <div class="hero-grid">
    <div class="clause-figure" aria-hidden="true">1</div>
    <div class="hero-copy">
      <p class="eyebrow">A clause catalogue for CC/ISO 36100</p>
      <h1>The standard document, <em>modelled.</em></h1>
      <p class="hero-lead">
        One StanDoc base defines the standardization document — metadata,
        sections, blocks, terms. Fifteen standards bodies overlay their own
        flavour on top. Every clause of this catalogue is drawn from the
        canonical LutaML sources; each flavour links to its schemas.
      </p>
      <p class="hero-isbd" aria-hidden="true">
        <span class="seg">1 StanDoc base</span><span class="punct">. — </span><span class="seg"><%= overlays.size %> flavour overlays</span><span class="punct"> : </span><span class="seg">LutaML sources</span><span class="punct"> / </span><span class="seg">RNC companions</span>
      </p>
    </div>
    <aside class="drawer" aria-label="Catalogue statistics">
      <div class="drawer-head">Catalogue contents</div>
      <dl class="drawer-list">
        <div><dt>Modules</dt><dd><%= mods.size %></dd></div>
        <div><dt>Diagram cards</dt><dd><%= total_cards %></dd></div>
        <div><dt>LML model files</dt><dd><%= total_models %></dd></div>
        <div><dt>Grammar companions</dt><dd><%= mods.count { |m| m.grammar } %></dd></div>
      </dl>
      <div class="drawer-foot">Clause 2 is the base; clause 3 lists the overlays</div>
    </aside>
  </div>
</section>

<section class="wrap">
  <div class="reading-rule">
    <strong>How to read the clauses</strong>
    <p>
      Numbering encodes the layering: clause <b>2</b> is the shared base,
      clause <b>3.n</b> the flavours that specialise it — a flavour extends the
      base, never the other way round. Flavour diagrams are
      <em>fully encapsulated</em>: each card draws only its own module in
      detail, and classes inherited from other layers appear as collapsed,
      name-only boxes. The base layer&rsquo;s cards are the exploded reference.
    </p>
  </div>
</section>

<section class="wrap catalog-section" aria-labelledby="base-heading">
  <div class="clause-head">
    <span class="clause-no">2</span>
    <div>
      <h2 id="base-heading">The StanDoc base layer</h2>
      <p class="clause-sub">The shared StandardDocument model every flavour specialises</p>
    </div>
    <a class="clause-more" href="standoc.html">All <%= base.cards.size %> base cards<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2"/></svg></a>
  </div>
  <div class="card-row">
    <% base.cards.first(3).each do |card| %>
      <a class="card" href="standoc.html#<%= card.name.downcase %>">
        <img src="<%= h card.image %>" alt="<%= h card.title %>" loading="lazy" width="640" height="480">
        <div class="card-body">
          <span class="card-code">STANDOC</span>
          <span class="card-title"><%= h card.title %></span>
        </div>
      </a>
    <% end %>
  </div>
  <ul class="base-strip" aria-label="Base layer companions">
    <% StandocSite::SUBMODULES.each do |name, blurb| %>
      <li><code><%= name %></code><span><%= blurb %></span></li>
    <% end %>
  </ul>
</section>

<section class="wrap catalog-section" aria-labelledby="flavors-heading">
  <div class="clause-head">
    <span class="clause-no">3</span>
    <div>
      <h2 id="flavors-heading">Flavour overlays</h2>
      <p class="clause-sub">One clause per standards body — open a flavour for its cards, grammar and schema browser</p>
    </div>
    <div class="chip-row" role="group" aria-label="Filter flavours">
      <button type="button" class="chip" data-filter="all" aria-pressed="true">All</button>
      <button type="button" class="chip" data-filter="has-diagrams" aria-pressed="false">With diagrams</button>
    </div>
  </div>
  <ol class="flavor-index">
    <% overlays.each do |mod| %>
      <li class="flavor-entry" data-cards="<%= mod.cards.size %>">
        <span class="fe-no"><%= mod.clause %></span>
        <a class="fe-main" href="<%= mod.name %>.html">
          <span class="fe-code"><%= mod.code %></span>
          <span class="fe-name"><%= h(mod.description || mod.name) %></span>
        </a>
        <span class="fe-meta">
          <span class="fe-count"><%= mod.cards.size %> card<%= mod.cards.size == 1 ? "" : "s" %></span>
          <span class="fe-models"><%= mod.model_files %> LML</span>
          <% if mod.grammar %><code class="fe-grammar <%= "legacy" if mod.legacy_grammar %>"><%= mod.grammar %></code><% end %>
          <a class="fe-spa" href="<%= mod.name %>/">schemas<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2"/></svg></a>
        </span>
      </li>
    <% end %>
  </ol>
</section>
